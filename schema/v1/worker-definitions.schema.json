{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://avli.cloud/l7/schema/v1/worker-definitions.schema.json",
  "title": "L7 Private Worker Definitions v1",
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "object",
      "required": [
        "id", "modality", "operations", "privacy_classes", "available",
        "models", "limits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "modality": {
          "enum": [
            "text", "document", "image", "video", "audio", "music",
            "automation"
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "privacy_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["public", "internal", "restricted"] }
        },
        "available": { "type": "boolean" },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "limits": {
          "type": "object",
          "required": ["max_concurrency", "max_input_bytes", "timeout_seconds"],
          "properties": {
            "max_concurrency": { "type": "integer", "minimum": 1 },
            "max_input_bytes": { "type": "integer", "minimum": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "contract_version", "worker_id", "worker_version", "generated_at",
        "capabilities"
      ],
      "properties": {
        "contract_version": { "const": "l7.worker.capabilities/1.0" },
        "worker_id": { "$ref": "#/definitions/identifier" },
        "worker_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "generated_at": { "type": "string", "format": "date-time" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/capability" }
        }
      },
      "additionalProperties": false
    },
    "callback": {
      "type": "object",
      "required": ["url", "key_id"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "key_id": { "$ref": "#/definitions/identifier" }
      },
      "additionalProperties": false
    },
    "jobRequest": {
      "type": "object",
      "required": [
        "contract_version", "request_id", "tenant_id", "capability", "input",
        "privacy_class", "deadline"
      ],
      "properties": {
        "contract_version": { "const": "l7.worker.job-request/1.0" },
        "request_id": { "$ref": "#/definitions/identifier" },
        "tenant_id": { "$ref": "#/definitions/identifier" },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "input": { "type": "object" },
        "privacy_class": {
          "enum": ["public", "internal", "restricted"]
        },
        "deadline": { "type": "string", "format": "date-time" },
        "callback": { "$ref": "#/definitions/callback" },
        "metadata": {
          "type": "object",
          "description": "Non-authoritative tracing metadata. Identity and policy are supplied by L7 headers."
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "sha256", "bytes", "media_type", "producer", "model",
        "license_id", "prompt_hash", "created_at"
      ],
      "properties": {
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "producer": { "$ref": "#/definitions/identifier" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": ["string", "null"], "maxLength": 256 },
        "license_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prompt_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256" },
            { "type": "null" }
          ]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "delivery_url": {
          "type": "string",
          "format": "uri",
          "description": "Short-lived delivery hint; never artifact identity."
        }
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "required": [
        "contract_version", "job_id", "request_id", "tenant_id", "capability",
        "state", "created_at", "updated_at", "progress", "artifacts", "error"
      ],
      "properties": {
        "contract_version": { "const": "l7.worker.job/1.0" },
        "job_id": { "$ref": "#/definitions/identifier" },
        "request_id": { "$ref": "#/definitions/identifier" },
        "tenant_id": { "$ref": "#/definitions/identifier" },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "state": {
          "enum": [
            "queued", "running", "succeeded", "failed", "cancelling",
            "cancelled"
          ]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "result": {},
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact" }
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": {
                  "enum": [
                    "VALIDATION_ERROR", "AUTHENTICATION_REQUIRED",
                    "AUTHORIZATION_DENIED", "POLICY_DENIED", "NOT_FOUND",
                    "CONFLICT", "DEPENDENCY_FAILURE", "PROVIDER_FAILURE",
                    "INTEGRITY_VIOLATION", "TIMEOUT", "CANCELLED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
