# L7 Morphic Media — local-only profile
# Copy values into your private launch environment; do not add secrets here.

AVLI_MEDIA_STORAGE=local
AVLI_MEDIA_ROOT=/Users/your-account/.l7/media
AVLI_MEDIA_EXECUTION=ssd1b
AVLI_IMAGE_MODEL=segmind/SSD-1B
AVLI_IMAGE_VAE=madebyollin/sdxl-vae-fp16-fix
AVLI_IMAGE_PRECISION=float32
AVLI_IMAGE_PYTHON=/Users/your-account/.l7/runtime/ssd1b/bin/python3
AVLI_IMAGE_STEPS=20
AVLI_IMAGE_GUIDANCE=9
AVLI_VIDEO_SWIFT=/usr/bin/swift
AVLI_VIDEO_FPS=30
# auto/native never causes paid egress. cluster keeps deterministic synthesis
# on Apple MPS and streams the final master through the AVLI Tailscale worker.
# comfy-cloud remains explicit and may incur provider cost.
AVLI_VIDEO_ENGINE=auto
AVLI_CLUSTER_SSH_HOST=avli
AVLI_CLUSTER_VIDEO_TIMEOUT_MS=600000
AVLI_COMFY_URL=http://127.0.0.1:8188
AVLI_VIDEO_CLOUD_TIMEOUT_MS=1200000
