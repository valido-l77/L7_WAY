# Loopback development identity. The tenant is derived by the gateway and is
# never accepted from a browser request body.
L7_LOCAL_TENANT_ID=tenant:local

# For one remote service identity, store the token outside source control and
# assign its tenant here.
L7_API_TOKEN=
L7_API_TENANT_ID=tenant:service

# For multiple service identities, inject a JSON object from the secret store:
# {"tenant:alpha":"secret-token-a","tenant:beta":"secret-token-b"}
L7_TENANT_TOKENS=
