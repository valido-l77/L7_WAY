[Unit]
Description=AVLI immutable media store
After=network.target

[Service]
Type=simple
User=avli
Group=avli
EnvironmentFile=/etc/avli-media-store.env
ExecStart=/usr/bin/node /opt/avli-media-store/avli-media-store.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/avli-media

[Install]
WantedBy=multi-user.target
